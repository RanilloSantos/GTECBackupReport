<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GTEC Backup Monitor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">G</span><span>GTEC <b>Backup Monitor</b></span></a><nav class="main-nav"><a class="active" asp-controller="Home" asp-action="Index">Overview</a><a asp-controller="Home" asp-action="Index" asp-fragment="backup-table">Reports</a></nav><div class="topbar-right"><span>INTERNAL MONITORING</span><partial name="_LoginPartial" /></div></header>
    <main class="app-shell">@RenderBody()</main>
    <footer class="site-footer"><span><strong>GTEC Backup Monitor</strong> · Internal reporting</span><span>Presence does not confirm backup integrity</span></footer>
    <div id="backup-flash-message" data-kind="@TempData["FlashKind"]" data-message="@TempData["FlashMessage"]" hidden></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/scripts/backup-alerts.js" asp-append-version="true"></script>
    <script src="~/scripts/backup-mappings.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

