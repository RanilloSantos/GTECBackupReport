@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{ ViewData["Title"] = "Production Backup Report"; }
<div class="backup-page" id="backup-dashboard">

<section class="dashboard-heading">
    <div>
        <div class="eyebrow">
            <span class="eyebrow-mark"></span> GTEC · BACKUP OPERATIONS
        </div>
        <h1>Production Backup Report</h1>
        <p class="subtitle">A clear view of expected backups across your environments.</p>
    </div>
    <div class="heading-actions"><button class="button button-primary" id="print-report" type="button">Print report</button></div>
</section>



<section class="summary-grid" aria-label="Report summary">
    <article class="summary-card">
        <span class="summary-icon">RPT</span>
        <div>
            <small>Expected backups</small>
            <strong id="expected-count">—</strong>
        </div>
        <em id="expected-caption">selected period</em>
    </article>
    <article class="summary-card good">
        <span class="summary-icon">OK</span>
        <div>
            <small>Working</small>
            <strong id="working-count">—</strong>
        </div>
        <em>files found</em>
    </article>
    <article class="summary-card bad">
        <span class="summary-icon">!</span>
        <div>
            <small>No Backup</small>
            <strong id="missing-count">—</strong>
        </div>
        <em>expected, not found</em>
    </article>
    <article class="summary-card">
        <span class="summary-icon">?</span>
        <div>
            <small>Unmapped</small>
            <strong id="unmapped-count">0</strong>
        </div>
        <em>files need a mapping</em>
    </article>
</section>

<section class="panel">
    <header class="panel-heading"><div class="panel-title"><div class="panel-title-row"><h2>Backup records</h2>@if (SignInManager.IsSignedIn(User)) {
    <button class="icon-button" id="mapping-settings" type="button" aria-label="Database mapping settings" title="Database mappings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm9 4.8v-2l-2.1-.6a7.2 7.2 0 0 0-.7-1.7l1.1-1.9-1.4-1.4-1.9 1.1a7.2 7.2 0 0 0-1.7-.7L13.7 3h-2l-.6 2.1a7.2 7.2 0 0 0-1.7.7L7.5 4.7 6.1 6.1l1.1 1.9a7.2 7.2 0 0 0-.7 1.7L4.4 10.3v2l2.1.6a7.2 7.2 0 0 0 .7 1.7l-1.1 1.9 1.4 1.4 1.9-1.1a7.2 7.2 0 0 0 1.7.7l.6 2.1h2l.6-2.1a7.2 7.2 0 0 0 1.7-.7l1.9 1.1 1.4-1.4-1.1-1.9a7.2 7.2 0 0 0 .7-1.7l2.1-.6Z"/></svg></button>
}</div>
        <p id="period-summary">Weekly report</p></div>
        <span class="count-pill" id="result-count">0 records</span>
    </header>
<div class="report-controls">
    <div class="period-tabs" role="group" aria-label="Report period">
        <button class="active" data-period="week" type="button">Weekly</button>
        <button data-period="month" type="button">Monthly</button>
        <button data-period="custom" type="button">Custom</button>
    </div>
    <label class="filter date-control" id="date-control" hidden>
        <span>Date range</span>
        <span class="date-inputs">
            <input id="date-from" type="date" aria-label="From date">
            <b>to</b>
            <input id="date-to" type="date" aria-label="To date"></span>
    </label>
    <label class="filter">
        <span>Backup source</span>
        <select id="source-filter">
            <option value="all-databases">All databases</option>
            <option value="all-files">All files</option>
            <option value="Unmapped">Unmapped</option>
        </select></label><label class="filter">
            <span>Status</span>
            <select id="status-filter">
                <option value="">All statuses</option>
                <option>Working</option>
                <option>No Backup</option>
                <option>Scanner Error</option><option>Unmapped</option>
            </select></label>
            <label class="filter">
                <span>File format</span>
                <select id="format-filter">
                    <option value="">All formats</option>
                    <option>.bak</option>
                    <option>.archive</option>
                    <option>.zip</option>
                </select>
            </label>
            <div class="filter search-filter"><span>Filename or prefix</span><div class="search-entry"><div class="search-terms" id="search-terms" aria-label="Active search terms"></div><input id="search-term-input" type="search" placeholder="Search filename or prefix" aria-label="Filename or prefix"><button id="add-search-term" type="button" aria-label="Add search term" title="Add search term"><span aria-hidden="true">&#10003;</span></button></div></div>
            <button class="clear-button" id="clear-filters" type="button">Clear filters</button>
</div>

<div class="print-meta" id="print-meta"></div>
<div class="table-scroll">
    <table id="backup-table">
        <thead>
            <tr>
                <th aria-sort="none"><button type="button" data-sort="day">Day <span class="sort-arrow" aria-hidden="true"></span></button></th>
                <th aria-sort="descending"><button type="button" data-sort="date">Date <span class="sort-arrow" aria-hidden="true"></span></button></th>
                <th aria-sort="none"><button type="button" data-sort="source">Database / Backup Source <span class="sort-arrow" aria-hidden="true"></span></button></th>
                <th><button type="button" data-sort="file">File Name / Format <span class="sort-arrow" aria-hidden="true"></span></button></th>
                <th aria-sort="none"><button type="button" data-sort="status">Status <span class="sort-arrow" aria-hidden="true"></span></button></th>
                
                
                <th class="actions">Actions</th>
            </tr>
        </thead>
        <tbody id="backup-rows"></tbody>
    </table>
    <div class="empty-state" id="empty-state" hidden>
        <b id="empty-kicker">NO RESULTS</b>
        <h3 id="empty-title">No backup records match</h3>
        <p id="empty-description">Try another period or clear a filter.</p>
        <button class="button button-outline" id="empty-clear" type="button">Clear filters</button>
        @if (SignInManager.IsSignedIn(User)) { <button class="button button-outline" id="empty-open-settings" type="button">Configure target folder</button> }
    </div>
</div>
<footer class="table-footer"><span id="page-summary">Showing 0 records</span><div><label for="page-size">Rows</label><select id="page-size"><option>10</option><option>25</option><option>50</option></select><button id="previous-page" aria-label="Previous page" type="button">‹</button><span id="page-number">1 / 1</span><button id="next-page" aria-label="Next page" type="button">›</button></div></footer></section><p class="footnote">File presence shows that a file was detected. It does not confirm that backup contents are valid.</p></div>
@section Scripts { <script src="~/scripts/backup-report-dashboard.js" asp-append-version="true"></script> }






